            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-bold uppercase tracking-wider text-white mb-1">Email Address</h3>
          <a href="mailto:tandat88963820@gmail.com" class="text-xs font-mono text-[#ffbd39] hover:underline break-all">
            tandat88963820@gmail.com
          </a>
        </div>
      </div>

      <!-- Phone Number -->
      <div class="p-8 rounded-lg bg-[#0c0d11] border border-[#1a1c24] text-center flex flex-col items-center justify-between hover:border-[#ffbd39] transition duration-300 group">
