            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-bold uppercase tracking-wider text-white mb-1">Phone Number</h3>
          <a href="tel:0984555752" class="text-xs font-mono text-[#ffbd39] hover:underline">
            0984 555 752
          </a>
        </div>
      </div>

      <!-- LinkedIn -->
      <div class="p-8 rounded-lg bg-[#0c0d11] border border-[#1a1c24] text-center flex flex-col items-center justify-between hover:border-[#ffbd39] transition duration-300 group">
