<section class="py-24 bg-[#000000] border-t border-[#141414]" id="contact-section">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Watermark Header Section -->
    <div class="heading-section text-center mb-14">
      <h1 class="big">Contact</h1>
      <span class="subheading">KẾT NỐI CHUYÊN MÔN</span>
      <h2 class="mb-3">Contact Me</h2>
      <p class="text-gray-400 text-sm max-w-2xl mx-auto">
        Tôi luôn sẵn lòng kết nối để trao đổi cơ hội nghề nghiệp trong các vị trí <strong>Oracle Database Administrator (DBA)</strong>, <strong>Data Platform Engineer</strong> hoặc thảo luận chuyên sâu về tối ưu hóa hệ thống dữ liệu.
      </p>
    </div>

    <!-- Contact Cards (Jijun Tang style with large round icon circles) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <!-- Email Address -->
      <div class="p-8 rounded-lg bg-[#0c0d11] border border-[#1a1c24] text-center flex flex-col items-center justify-between hover:border-[#ffbd39] transition duration-300 group">
        <div class="w-16 h-16 rounded-full bg-[#161822] flex items-center justify-center text-[#ffbd39] mb-4 group-hover:scale-110 transition duration-300">
