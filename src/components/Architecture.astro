---
interface Props { comparison?: boolean; }
const { comparison = true } = Astro.props;
interface Drawing { id: string; name: string; height: number; title: string; description: string; videoId?: string; github?: string; original?: string; screenshots?: { src: string; title: string; caption: string; width: number; height: number }[]; }
const drawings: Drawing[] = [
  { id: "network-topology", name: "Network overview", height: 1080, title: "Bốn vùng mạng trên một NixOS host", description: "Compute, HDFS storage, Oracle public và RAC private; kết nối database qua firewall, SCAN và VIP." },
  { id: "oracle-rac", name: "Oracle RAC", height: 1060, title: "Oracle RAC & Data Guard", description: "Client nhận redirect từ SCAN rồi kết nối tới VIP. Hai instance dùng shared ASM, trao đổi Cache Fusion và vận chuyển redo sang physical standby.", videoId: "-eH738r5fRQ", github: "https://github.com/tandat8896/oracle-rac-data-guard-lab" },
  { id: "oracle-memory", name: "SGA / PGA & I/O", height: 1320, title: "Bên trong Oracle: memory, process và I/O", description: "SGA theo instance, PGA theo process. LGWR ghi redo trước khi xác nhận COMMIT; DBWn ghi dirty blocks độc lập; CKPT điều phối checkpoint. Thông số là snapshot trước tuning trong tài liệu lab.", github: "https://github.com/tandat8896/oracle-rac-data-guard-lab/tree/main/docs/query-tuning" },
  { id: "hadoop-spark", name: "Hadoop & Spark", height: 1390, title: "Topology của cụm Hadoop / Spark HA", description: "Master cấp executor; driver trao đổi task/result với executor. HDFS metadata đi qua NameNode, block đi tới DataNode. ZooKeeper và JournalNode là hai nhóm HA riêng." },
  { id: "medallion-nix", name: "Medallion / Nix", height: 1120, title: "Medallion Data Platform — local ETL lab", description: "Kafka → Flink → Bronze NDJSON; Spark xử lý Silver và Gold Parquet. Có code JDBC loader và migration PostgreSQL; README vẫn để lượt nạp Gold và Airflow ở trạng thái chờ. IoT KPI còn placeholder.", github: "https://github.com/tandat8896/standard-medallion-apache-ecosystem-on-nix", original: "/architecture/medallion-original.svg" },
  { id: "solar-pv", name: "Solar PV / Architecture", height: 1460, title: "Phân tích hiệu suất & dự báo điện mặt trời", description: "Vai trò: Data & AI Lead — nhóm The Outliers. GMM–IF phát hiện ngoại lai; LightGBM dự báo; Explainable AI bằng SHAP. Optuna là nhánh tối ưu riêng, tham số được duyệt thủ công trước khi dùng. PostgreSQL phục vụ BI/ML marts, Tableau và Streamlit.", github: "https://github.com/tandat8896/datn_outlier_hs_nlmt" },
  { id: "solar-results", name: "Solar PV / Dashboard", height: 1080, title: "Dashboard & Explainable AI", description: "Kết quả đồ án Solar PV · Data & AI Lead — The Outliers.", github: "https://github.com/tandat8896/datn_outlier_hs_nlmt", screenshots: [
    { src: "/architecture/solar-dashboard.png", title: "Tableau · dashboard hiệu suất", caption: "Ảnh dashboard gốc trong báo cáo: sản lượng, hiệu suất và so sánh theo campus.", width: 1920, height: 1080 },
    { src: "/architecture/solar-forecast.png", title: "Dự báo · Streamlit", caption: "Snapshot trong báo cáo. Các chỉ số thuộc cấu hình và phạm vi ghi trên ảnh; không dùng thay cho một kết quả benchmark chung.", width: 1680, height: 1150 },
    { src: "/architecture/solar-shap.png", title: "Explainable AI · SHAP", caption: "Feature importance, beeswarm và giải thích từng dự báo — ảnh kết quả gốc trong báo cáo.", width: 1680, height: 1150 },
  ] },
];
const initialId = comparison ? "network-topology" : "oracle-rac";
---

<section id="arch-architecture-section" class:list={{ "arch-selected": !comparison }} aria-label="Kiến trúc các project">
  <div class="arch-inner">
    <details class="arch-comparison" open>
      <summary>
        <span class="arch-heading"><span class="arch-label">SYSTEM ARCHITECTURE</span><span class="arch-title">Architecture &amp; Network Topology</span></span>
        <span class="arch-switch"><span class="when-open">Ẩn bản này −</span><span class="when-closed">Hiện bản này +</span></span>
      </summary>
      <div class="arch-body">
        <div class="arch-intro"><p>AWS-style diagrams · Sơ đồ phân tầng mạng và luồng dữ liệu hệ thống.</p><a href="/architecture/index.html" target="_blank" rel="noopener noreferrer">Mở workspace sơ đồ ↗</a></div>
        <div class="arch-tabs" role="group" aria-label="Chọn sơ đồ kiến trúc">
          {drawings.map((drawing, i) => <button type="button" data-arch-tab={drawing.id} aria-pressed={drawing.id === initialId ? "true" : "false"} aria-controls={`arch-panel-${drawing.id}`}><span>{String(i).padStart(2, "0")}</span>{drawing.name}</button>)}
        </div>
        {drawings.map(drawing => (
          <figure id={`arch-panel-${drawing.id}`} data-arch-panel={drawing.id} hidden={drawing.id !== initialId}>
            {!drawing.screenshots && <div id={`diagram-${drawing.id}`} class="arch-canvas" tabindex="0" aria-label={`${drawing.title}. Cuộn ngang để xem trên màn hình nhỏ.`}>
              <a href={`/architecture/index.html#${drawing.id}`} target="_blank" rel="noopener noreferrer" aria-label={`Mở và phóng to ${drawing.title}`}><img src={`/architecture/${drawing.id}.svg`} alt={`${drawing.title}. ${drawing.description}`} width="1600" height={drawing.height} loading="lazy" /></a>
            </div>}
            <figcaption><div><h3>{drawing.title}</h3><p>{drawing.description}</p></div></figcaption>
            {drawing.videoId && (
              <div class="arch-demo">
                <div class="arch-demo-heading"><div><span class="demo-kicker">VIDEO DEMO / KẾT QUẢ THỰC NGHIỆM</span><h3>Đi từ bản vẽ đến hệ thống chạy thật.</h3><p>Video kết quả cấu hình cụm Oracle RAC hai node.</p></div><a href={`https://www.youtube.com/watch?v=${drawing.videoId}`} target="_blank" rel="noopener noreferrer">Xem trên YouTube ↗</a></div>
                <iframe src={`https://www.youtube-nocookie.com/embed/${drawing.videoId}?enablejsapi=1`} title="Video demo: Oracle RAC 19c two-node cluster configuration — Ngô Tấn Đạt" loading="lazy" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
              </div>
            )}
            {drawing.original && <div class="arch-source"><a href={drawing.original} target="_blank" rel="noopener noreferrer">Xem bản architecture gốc của project ↗</a></div>}
            {drawing.screenshots && <div class="arch-results">
              <div class="results-heading"><span>PROJECT RESULTS / DATA &amp; AI LEAD</span><h3>Dashboard &amp; kết quả thực tế</h3><p>Ảnh lưu từ báo cáo đồ án · không phải dữ liệu live. Bấm ảnh để xem khổ lớn.</p></div>
              <div class="result-tabs" role="group" aria-label="Chọn ảnh kết quả">{drawing.screenshots.map((shot, i) => <button type="button" data-result-tab={i} aria-pressed={i === 0 ? "true" : "false"} aria-controls={`result-${drawing.id}-${i}`}>{shot.title}</button>)}</div>
              {drawing.screenshots.map((shot, i) => <div class="result-shot" id={`result-${drawing.id}-${i}`} data-result-panel={i} hidden={i !== 0}><a href={shot.src} target="_blank" rel="noopener noreferrer" aria-label={`Mở ảnh lớn: ${shot.title}`}><img src={shot.src} alt={shot.title} width={shot.width} height={shot.height} loading="lazy" /></a><p>{shot.caption}</p></div>)}
            </div>}
            {drawing.github && <div class="arch-source"><a href={drawing.github} target="_blank" rel="noopener noreferrer">Mã nguồn &amp; tài liệu của project ↗</a></div>}
          </figure>
        ))}
      </div>
    </details>
  </div>
</section>

<style>
  .arch-results { padding:24px;border-top:1px solid #dce2e8;color:#232f3e;background:#f7f8f4; }
  .results-heading>p{font-size:11px;color:#526477;margin:8px 0 18px}.result-tabs{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:16px}.result-tabs button{font:inherit;font-size:11px;line-height:1.6;border:1px solid #c5cec0;padding:8px 12px;background:#fff;color:#344939;cursor:pointer}.result-tabs button[aria-pressed="true"]{background:#293e32;color:#fff;border-color:#293e32}.result-shot[hidden]{display:none}.result-shot img{max-height:560px;object-fit:contain;background:#fff}.result-shot p{margin-top:10px!important}.arch-canvas{scroll-margin-top:30px}
  @media(prefers-reduced-motion:no-preference){figure:not([hidden]){animation:sheet-enter .25s ease-out}.result-shot:not([hidden]){animation:sheet-enter .2s ease-out}@keyframes sheet-enter{from{opacity:.3;transform:translateY(5px)}to{opacity:1;transform:translateY(0)}}}
  .results-heading { grid-column:1/-1; }.results-heading>span{font:10px monospace;letter-spacing:1.5px;color:#8e450d}.results-heading h3{font-size:20px;font-weight:500;margin:6px 0 0}.result-shot{min-width:0}.result-shot img{display:block;width:100%;height:auto;border:1px solid #dce2e8}.result-shot h4{font-size:13px;margin:15px 0 7px}.result-shot p{font-size:11px;line-height:1.8;color:#526477;margin:0}
  @media(max-width:700px){.arch-results{grid-template-columns:1fr;padding:18px}}
  section { padding: 64px 0; background: #10161f; border-top: 1px solid #2c3543; scroll-margin-top: 80px; }
  .arch-inner { max-width: 1440px; margin: 0 auto; padding: 0 28px; }
  details { border: 1px solid #3c4654; background: #fff; }
  summary { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 26px 28px; background: #192331; color: #fff; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  .arch-heading { display: flex; flex-direction: column; gap: 5px; }
  .arch-label { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 2px; color: #ffca86; }
  .arch-title { font-size: clamp(19px, 2.2vw, 29px); font-weight: 600; line-height: 1.35; }
  .arch-switch { flex-shrink: 0; font-size: 12px; border: 1px solid #526173; padding: 8px 14px; }
  .when-closed { display: none; }
  details:not([open]) .when-closed { display: inline; }
  details:not([open]) .when-open { display: none; }
  .arch-intro, .arch-bottom { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 18px 25px; color: #526477; font-size: 12px; line-height: 1.7; }
  .arch-intro { border-bottom: 1px solid #dce2e8; }
  .arch-intro p, figcaption p { margin: 0; }
  .arch-intro a, .arch-bottom a { color: #8e450d; text-underline-offset: 4px; flex-shrink: 0; }
  .arch-tabs { display: flex; overflow-x: auto; border-bottom: 1px solid #dce2e8; }
  .arch-tabs button { font: inherit; font-size: 12px; padding: 17px 23px; background: #fff; border: none; border-right: 1px solid #dce2e8; color: #334155; cursor: pointer; white-space: nowrap; }
  .arch-tabs button span { font-family: monospace; margin-right: 12px; color: #718096; }
  .arch-tabs button[aria-pressed="true"] { background: #232f3e; color: #fff; }
  .arch-tabs button[aria-pressed="true"] span { color: #ffc073; }
  .arch-tabs button:hover:not([aria-pressed="true"]) { background: #f2f5f8; }
  figure { margin: 0; }
  figure[hidden] { display: none; }
  .arch-canvas { overflow-x: auto; background: #fff; }
  .arch-canvas a { display: block; min-width: 900px; }
  .arch-canvas img { display: block; width: 100%; height: auto; }
  figcaption { display: flex; align-items: center; justify-content: space-between; gap: 30px; border-top: 1px solid #dce2e8; padding: 20px 26px; background: #f5f7fa; }
  figcaption h3 { font-size: 14px; color: #232f3e; margin: 0 0 5px; font-weight: 600; }
  figcaption p { font-size: 12px; line-height: 1.7; color: #526477; max-width: 850px; }
  figcaption a { font-size: 12px; color: #8e450d; flex-shrink: 0; }
  .arch-bottom { border-top: 1px solid #dce2e8; font-size: 11px; justify-content: flex-end; }
  .arch-selected { padding: 0; background: transparent; border: 0; }
  .arch-selected .arch-inner { max-width: none; padding: 0; }
  .arch-selected details { border-color: #d8ddd9; }
  .arch-selected summary, .arch-selected .arch-intro { display: none; }
  .arch-demo { padding: 30px; border-top: 1px solid #dce2e8; background: #fff; }
  .arch-demo-heading { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-bottom: 22px; }
  .demo-kicker { font-family: monospace; font-size: 10px; letter-spacing: 2px; color: #8e450d; }
  .arch-demo h3 { font-size: 20px; color: #232f3e; font-weight: 500; margin: 5px 0; }
  .arch-demo p { font-size: 13px; color: #526477; margin: 0; }
  .arch-demo a, .arch-source a { font-size: 12px; color: #8e450d; }
  .arch-demo iframe { width: 100%; aspect-ratio: 16 / 9; display: block; border: 0; background: #142031; }
  .arch-source { padding: 16px 26px; border-top: 1px solid #dce2e8; }
  button:focus-visible, a:focus-visible, summary:focus-visible, .arch-canvas:focus-visible { outline: 3px solid #b95712; outline-offset: -3px; }
  @media (max-width: 700px) {
    section { padding: 36px 0; }
    .arch-inner { padding: 0 12px; }
    summary { padding: 20px 16px; align-items: flex-start; }
    .arch-switch { padding: 5px 9px; font-size: 10px; }
    .arch-title { font-size: 18px; }
    .arch-intro, .arch-bottom, figcaption { flex-direction: column; align-items: flex-start; padding: 16px; gap: 10px; }
    .arch-tabs button { padding: 15px 18px; }
    .arch-selected { padding: 0; }
    .arch-selected .arch-inner { padding: 0; }
    .arch-demo { padding: 18px; }
    .arch-demo-heading { flex-direction: column; align-items: flex-start; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".arch-results").forEach(gallery => {
    gallery.querySelectorAll<HTMLButtonElement>("[data-result-tab]").forEach(button => button.addEventListener("click", () => {
      gallery.querySelectorAll<HTMLButtonElement>("[data-result-tab]").forEach(tab => tab.setAttribute("aria-pressed", String(tab === button)));
      gallery.querySelectorAll<HTMLElement>("[data-result-panel]").forEach(panel => { panel.hidden = panel.dataset.resultPanel !== button.dataset.resultTab; });
    }));
  });

  const archRoot = document.getElementById("arch-architecture-section");
  archRoot?.querySelectorAll<HTMLButtonElement>("[data-arch-tab]").forEach(button => {
    button.addEventListener("click", () => {
      const selected = button.dataset.archTab;
      button.scrollIntoView({ block: "nearest", inline: "nearest", behavior: "instant" });
      archRoot.querySelectorAll<HTMLButtonElement>("[data-arch-tab]").forEach(tab => {
        tab.setAttribute("aria-pressed", String(tab.dataset.archTab === selected));
      });
      archRoot.querySelectorAll<HTMLElement>("[data-arch-panel]").forEach(panel => {
        panel.hidden = panel.dataset.archPanel !== selected;
        if (panel.hidden) {
          // Stop a playing YouTube video when its diagram is hidden.
          panel.querySelectorAll<HTMLIFrameElement>("iframe").forEach(frame => {
            frame.contentWindow?.postMessage(JSON.stringify({ event: "command", func: "pauseVideo", args: [] }), "https://www.youtube-nocookie.com");
          });
        }
      });
    });
  });
</script>
