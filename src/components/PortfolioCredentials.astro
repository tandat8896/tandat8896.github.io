---
const modules = ["Data Analysis & Data Science", "Machine Learning / Deep Learning", "Computer Vision & NLP", "GenAI & LLMs"];
const verificationCodes = ["15917025", "66174496", "47792449", "94470420"];
---
<article class="timeline-credential" id="certificates-section" aria-labelledby="aio-credential-title">
  <span class="credential-date">CERTIFICATES / 06 · 2026</span>
  <h3 id="aio-credential-title">AI VIETNAM — AIO 2025</h3>
  <p>Hoàn thành bốn học phần chuyên sâu:</p>
  <ul>{modules.map(module => <li>{module}</li>)}</ul>
  <div class="verification"><span>Mã tra cứu</span><div>{verificationCodes.map(code => <code>{code}</code>)}</div></div>
  <a href="https://lms.aivietnam.edu.vn/verification" target="_blank" rel="noopener noreferrer">Tra cứu trên AI VIETNAM LMS ↗</a>
</article>
<article class="timeline-credential" aria-labelledby="aws-credential-title">
  <span class="credential-date">CERTIFICATES / 05 · 2026 — 05 · 2029</span>
  <h3 id="aws-credential-title">AWS Certified Cloud Practitioner</h3>
  <p>Amazon Web Services · kiến thức nền tảng về cloud, bảo mật và các dịch vụ AWS cốt lõi.</p>
  <a href="https://cp.certmetrics.com/amazon/en/public/verify/credential/d3a4033b541240559beaf402394c9fae" target="_blank" rel="noopener noreferrer">Xem AWS credential ↗</a>
</article>
<style>
  .timeline-credential { position:relative;padding-bottom:26px;margin-bottom:24px;border-bottom:1px solid var(--line,#d5dad1);scroll-margin-top:95px; }
  .timeline-credential::before { content:'';position:absolute;left:-35px;top:5px;width:9px;height:9px;border:1px solid #97a48d;background:var(--paper,#f6f5f0); }
  .credential-date { font:9px 'IBM Plex Mono',monospace;letter-spacing:1px;color:var(--accent,#a45429); }
  .timeline-credential h3 { font-family:inherit;font-size:16px;font-weight:600;line-height:1.5;color:var(--ink,#243a32);margin:9px 0 5px; }
  .timeline-credential p,.timeline-credential li { font-size:12px;color:var(--muted,#64736d);line-height:1.85; }
  .timeline-credential p { margin:0; }.timeline-credential ul { margin:10px 0 14px;padding-left:17px;list-style:disc; }
  .verification { margin:14px 0;font:9px 'IBM Plex Mono',monospace;color:var(--muted,#64736d); }
  .verification>div { display:flex;flex-wrap:wrap;gap:9px;margin-top:7px; }.verification code { font:10px 'IBM Plex Mono',monospace;color:var(--ink,#243a32);border-bottom:1px solid #c5cdbd;padding-bottom:3px; }
  .timeline-credential a { display:inline-block;margin-top:10px;font-size:11px;color:var(--accent,#a45429);text-decoration:none; }.timeline-credential a:hover { text-decoration:underline;text-underline-offset:4px; }
  @media(max-width:700px) { .timeline-credential::before { left:-29px; } }
</style>
