<section class="py-24 bg-[#000000] border-t border-[#141414]" id="projects-section">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="mb-14 text-center">
      <span class="text-xs font-mono uppercase tracking-[3px] text-[#ffbd39] font-bold block mb-2">
        // PRODUCTION ARCHITECTURE DIAGRAMS &amp; LAB BENCHMARKS
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Sơ Đồ Kiến Trúc Hệ Thống (Cloud &amp; Data Architectures)
      </h2>
      <p class="text-xs sm:text-sm font-mono text-gray-400 mt-2 max-w-2xl mx-auto">
        Thiết kế theo chuẩn kiến trúc chuyên nghiệp (AWS / MLOps / Systems Architecture). Tích hợp các luồng dữ liệu sống (Living Data Flow) với icon công nghệ chính thức.
      </p>
    </div>

    <!-- Architecture Canvas Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      {PROJECTS.map(project => (
        <div
          class="project-card flex flex-col justify-between rounded-xl overflow-hidden border border-[#1e2333] hover:border-[#ffbd39] cursor-pointer group transition-all duration-300 shadow-2xl bg-[#07080d]"
          data-project-id={project.id}
        >
          <!-- Top Architecture Diagram Canvas -->
          <div class="relative p-4 sm:p-5 bg-[#05060a] border-b border-[#181a26] overflow-hidden flex items-center justify-center">
            {project.id === "oracle-rac-ha" && (
              <svg class="w-full h-auto max-h-[340px]" viewBox="0 0 920 400" fill="none" xmlns="http://www.w3.org/2000/svg">
                <defs>
                  <pattern id="aws-grid-rac" width="24" height="24" patternUnits="userSpaceOnUse">
                    <circle cx="12" cy="12" r="0.75" fill="#334155" opacity="0.3"/>
                  </pattern>
                  <marker id="aws-arrow-orange" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
                    <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#f97316"/>
                  </marker>
                  <marker id="aws-arrow-blue" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
                    <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#38bdf8"/>
                  </marker>
                  <marker id="aws-arrow-purple" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
                    <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#c084fc"/>
                  </marker>
                  <marker id="aws-arrow-emerald" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
                    <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#10b981"/>
                  </marker>
                </defs>

                <!-- Background -->
                <rect width="920" height="400" fill="#070a12"/>
                <rect width="920" height="400" fill="url(#aws-grid-rac)"/>

                <!-- AWS Architecture Header Bar -->
                <rect x="16" y="10" width="888" height="24" rx="4" fill="#0f172a" stroke="#1e293b" stroke-width="1"/>
                <text x="28" y="26" fill="#f97316" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="10" font-weight="bold">AWS REFERENCE ARCHITECTURE: ORACLE 19c ENTERPRISE RAC &amp; DATA GUARD HA</text>
                <text x="600" y="26" fill="#94a3b8" font-family="monospace" font-size="8.5">Dual-Node Active-Active • Shared ASM • Zero-Trust L4</text>
                <text x="892" y="26" text-anchor="end" fill="#10b981" font-family="monospace" font-size="8.5" font-weight="bold">AVAILABILITY: 99.999%</text>

                <!-- ================= VPC BOUNDARY CONTAINER ================= -->
                <rect x="16" y="42" width="888" height="346" rx="8" fill="none" stroke="#3b82f6" stroke-width="1.2" stroke-dasharray="6 4"/>
                <rect x="26" y="34" width="165" height="18" rx="3" fill="#1e3a8a"/>
                <text x="108" y="46" text-anchor="middle" fill="#bfdbfe" font-family="monospace" font-size="8" font-weight="bold">VPC: 10.10.0.0/16 (Corporate Lab)</text>

                <!-- ================= SUBNET 1: CLIENT / COMPUTE SUBNET ================= -->
                <rect x="28" y="60" width="125" height="316" rx="6" fill="#0284c7" fill-opacity="0.04" stroke="#0284c7" stroke-width="1"/>
                <rect x="36" y="52" width="105" height="16" rx="3" fill="#0369a1"/>
                <text x="88" y="63" text-anchor="middle" fill="#e0f2fe" font-family="monospace" font-size="7.5" font-weight="bold">Compute 10.10.20.0/24</text>

                <!-- Client Icon Node -->
                <rect x="42" y="90" width="96" height="85" rx="6" fill="#0c1626" stroke="#38bdf8" stroke-width="1.2"/>
                <circle cx="90" cy="115" r="16" fill="#0369a1"/>
                <path d="M 83 121 v -2 a 7 7 0 0 1 14 0 v 2 M 90 111 a 3.5 3.5 0 1 0 0 -7 a 3.5 3.5 0 0 0 0 7 z" fill="none" stroke="#ffffff" stroke-width="1.6"/>
                <text x="90" y="142" text-anchor="middle" fill="#ffffff" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="9" font-weight="bold">Spark / App</text>
                <text x="90" y="154" text-anchor="middle" fill="#38bdf8" font-family="monospace" font-size="7.5">10.10.20.10</text>
                <text x="90" y="165" text-anchor="middle" fill="#94a3b8" font-family="monospace" font-size="6.8">Thin JDBC Client</text>

                <!-- Security Box Note -->
                <rect x="36" y="240" width="108" height="80" rx="4" fill="#08101a" stroke="#1e293b" stroke-width="0.8"/>
