---
interface ProjectItem {
  id: string;
  title: string;
  category: string;
  timeline: string;
  summary: string;
  githubUrl?: string;
  youtubeUrl?: string;
  context: string;
  missions: string[];
  results: string[];
  techEnv: string[];
  challenges: { problem: string; solution: string }[];
}

const PROJECTS: ProjectItem[] = [
  {
    id: "oracle-rac-ha",
    title: "Oracle RAC 19c Active-Active & Data Guard HA Enterprise Architecture",
    category: "Enterprise High Availability & Storage Clustering",
    timeline: "2026",
    summary: "Cụm cơ sở dữ liệu quan trọng 2-node Active-Active (Oracle Linux 9) trên Oracle ASM (3 disk groups) kết hợp Data Guard Physical Standby (FSFO) và phân vùng mạng Zero-Trust L4.",
    githubUrl: "https://github.com/tandat8896/oracle-rac-data-guard-lab",
    youtubeUrl: "https://www.youtube.com/watch?v=-eH738r5fRQ",
    context: "Hệ thống cơ sở dữ liệu sản xuất quy mô lớn đòi hỏi tính sẵn sàng liên tục 99.999%, đảm bảo không gián đoạn dịch vụ khi một node vật lý gặp thảm họa và tự động chuyển đổi dự phòng (Zero-Loss Failover) mà không cần can thiệp thủ công.",
    missions: [
      "Dựng cụm Active-Active gồm 2 node (racdb1 và racdb2) trên Oracle Linux với Clusterware (CRS) đồng bộ online song song.",
      "Cấu hình Oracle ASM quản lý 3 disk groups độc lập: +OCRVOTE (10GB - Voting Disks), +DATA (30GB - Database Datafiles) và +FRA (30GB - Fast Recovery Area / Archive Logs) cố định bằng udev rules.",
      "Thiết lập mạng Private Interconnect MTU 9000 dành riêng cho Cache Fusion; SCAN Listener tập trung (10.10.50.30:1521) phục vụ cân bằng tải kết nối qua Virtual IPs (VIPs).",
      "Thiết lập Physical Standby kết nối qua Data Guard Broker với cơ chế Fast-Start Failover (FSFO) và Observer tự động điều phối."
    ],
    results: [
      "Hoàn thành trọn vẹn chu trình Switchover, Failover và Reinstate Standby bằng Flashback Database.",
      "RMAN online hot backup validate 100% dữ liệu vào diskgroup +FRA.",
      "Biên soạn 57 tài liệu kỹ thuật chi tiết cùng video demo dài thực nghiệm công khai trên GitHub và YouTube."
    ],
    techEnv: [
      "Oracle RAC 19c Enterprise",
      "Oracle ASM",
      "Data Guard Broker",
      "Fast-Start Failover (FSFO)",
      "Oracle Linux 9 UEK",
      "AWR / ASH Profiling",
      "Flashback Database",
      "RMAN Hot Backup",
      "udev rules",
      "KVM Bare-Metal"
    ],
    challenges: [
      {
        problem: "Lỗi ORA-1017 (invalid username/password) khi kích hoạt Fast-Start Failover giữa primary và standby.",
        solution: "Phát hiện tiện ích orapwd chạy độc lập trên từng node tạo ra chuỗi cryptographic salt khác nhau cho tài khoản SYS. Khắc phục bằng cách copy đồng bộ file password từ primary sang standby và khởi tạo lại static listener."
      },
      {
        problem: "Lỗi ORA-1033 (ORACLE initialization or shutdown in progress) khi Data Guard Broker thực hiện switchover.",
        solution: "Thiếu cấu hình static service listener _DGMGRL trong listener.ora khiến broker không thể kết nối restart instance khi database đang ở trạng thái MOUNT."
      }
    ]
  },
  {
    id: "hadoop-spark-ha",
    title: "Apache Hadoop HA & Spark Cluster (Zero-Trust L4 Segregation)",
    category: "Distributed Big Data HA & Enterprise Network Hardening",
    timeline: "2026",
    summary: "Cụm 3-node Rocky Linux triển khai Hadoop HA (Active/Standby NameNodes, JournalNode Quorum 3/3, ZooKeeper Ensemble 3-node, DataNodes) kết hợp Spark Master HA và Spark Workers. Phân tách rạch ròi Storage HDFS cô lập Air-Gapped khỏi Compute, kết nối tới Oracle RAC qua tường lửa Zero-Trust L4.",
    githubUrl: "https://github.com/tandat8896/oracle-rac-data-guard-lab",
    context: "Hạ tầng Big Data doanh nghiệp đòi hỏi tính sẵn sàng cao (Zero Single Point of Failure) cho cả tầng lưu trữ phân tán HDFS và tầng tính toán Spark, đồng thời phải thiết lập vành đai bảo mật Zero-Trust L4 ngăn chặn rò rỉ dữ liệu hoặc tấn công nội bộ giữa vùng tính toán và vùng cơ sở dữ liệu lõi.",
    missions: [
      "Triển khai cụm 3 node Rocky Linux (datanode, workernode1, workernode2) với card mạng kép tách biệt Compute (10.10.20.0/24) và Storage HDFS (10.10.30.0/24).",
      "Cấu hình Hadoop HDFS HA với 2 NameNodes (Active nn1 trên datanode, Standby nn2 trên workernode1), đồng bộ edits log qua JournalNode Quorum (3 node) và tự động failover bằng ZKFC.",
      "Thiết lập Apache ZooKeeper 3.8 Quorum 3 nodes phục vụ đồng thuận phân tán cho cả NameNode và Spark Master HA.",
      "Triển khai Apache Spark Standalone Cluster với Active Spark Master và Standby Spark Master phục hồi trạng thái qua ZooKeeper, kết hợp 2 Spark Workers thực thi tính toán phân tán.",
      "Thiết lập vành đai tường lửa Zero-Trust L4 trên host NixOS: Chỉ mở duy nhất TCP 1521 tới SCAN RAC (10.10.50.30) và RAC VIPs (.21, .22), chặn toàn bộ SSH (22) và direct node IPs, cô lập 100% mạng HDFS Private."
    ],
    results: [
      "HDFS HA tự động failover thành công dưới 3 giây khi ngắt NameNode Active.",
      "Spark Master tự động bầu chọn và phục hồi ứng dụng qua ZooKeeper không làm đứt gãy job đang chạy.",
      "Xác thực đo kiểm 100% 4 luật tường lửa Zero-Trust: Spark JDBC sang SCAN đạt 0.01s, quét port SSH hoặc chọc node IP vật lý đều bị DROP timeout ngay lập tức."
    ],
    techEnv: [
      "Apache Hadoop 3.3.6 HDFS HA",
      "Apache Spark 3.5 Standalone HA",
      "Apache ZooKeeper 3.8 Quorum",
      "JournalNode Quorum (3/3)",
      "ZKFC (Failover Controller)",
      "Rocky Linux 10 & KVM Hypervisor",
      "Zero-Trust iptables L4 Hardening",
      "Oracle RAC JDBC Integration",
      "virbr Network Segregation"
    ],
    challenges: [
      {
        problem: "Hiện tượng Split-Brain khi mạng giữa 2 NameNode bị chập chờn, cả 2 node đều tự nhận là Active gây hỏng dữ liệu HDFS.",
        solution: "Cấu hình cơ chế Fencing thông qua SSH fencing agent và cấu hình JournalNode Quorum yêu cầu quá bán (2/3 nodes đồng thuận) mới cho phép commit transaction log."
      },
      {
        problem: "Spark Driver / Workers bị kẹt kết nối khi truy vấn Oracle RAC do SCAN chuyển hướng TNS REDIRECT tới Local Listener trên node IP.",
        solution: "Bổ sung luật tường lửa Zero-Trust mở thêm cổng 1521 tới 2 địa chỉ RAC VIPs (10.10.50.21, 10.10.50.22) song song với SCAN IP, đảm bảo quy trình bắt tay TNS REDIRECT hoàn tất mà vẫn giữ nguyên chính sách chặn toàn bộ cổng quản trị."
      }
    ]
  },
  {
    id: "zero-downtime-cdc",
    title: "Zero-Downtime Real-Time CDC Migration Pipeline to Apache Iceberg",
    category: "Real-time CDC & Data Governance",
    timeline: "2026",
    summary: "Pipeline đồng bộ dữ liệu thời gian thực từ PostgreSQL qua logical replication (pgoutput) bằng Debezium Server 2.5, chuẩn hóa Avro với Confluent Schema Registry, Spark stream nạp vào Apache Iceberg với SCD Type 2.",
    githubUrl: "https://github.com/tandat8896/migration-data-pipeline",
    context: "Chuyển dịch dữ liệu sản xuất từ cơ sở dữ liệu quan hệ giao dịch OLTP sang Data Lakehouse phân tích hiện đại mà không gây gián đoạn hệ thống (Zero-Downtime), bảo đảm theo dõi toàn vẹn lịch sử thay đổi của từng thuộc tính.",
    missions: [
      "PostgreSQL logical replication plugin (pgoutput) xuất chuỗi thay đổi Write-Ahead Log (WAL).",
      "Debezium Server 2.5.4 bắt các sự kiện INSERT / UPDATE / DELETE và chuyển đổi thành thông điệp nhị phân.",
      "Confluent Schema Registry quản trị phiên bản schema Avro, kiểm tra tương thích ngược (backward compatibility).",
      "Spark Streaming giải mã Confluent Wire Format (Magic Byte + Schema ID), làm phẳng cấu trúc CDC Envelope (before, after, op, ts_ms).",
      "Ghi dữ liệu vào Apache Iceberg Table Format, thiết lập cột version và is_current mô hình hóa dữ liệu biến đổi chậm SCD Type 2."
    ],
    results: [
      "Kiểm chứng tính toàn vẹn 100% của mọi thao tác INSERT, UPDATE, DELETE.",
      "Hỗ trợ truy vấn lịch sử (Time-Travel Queries) nhờ cơ chế snapshot của Apache Iceberg."
    ],
    techEnv: [
      "Debezium Server 2.5.4",
      "PostgreSQL Logical Replication",
      "Apache Iceberg",
      "Confluent Schema Registry",
      "Apache Spark Streaming",
      "Avro Serialization",
      "SCD Type 2 Modeling"
    ],
    challenges: [
      {
        problem: "Lỗi double serialization giữa Debezium Server và Apache Kafka khiến dữ liệu Avro bị đóng gói kép trong JSON wrapper, làm Spark consumer không thể phân tích byte.",
        solution: "Cấu hình ByteArraySerializer cho Kafka producer trong Debezium, truyền trực tiếp luồng byte thuần đã được mã hóa bởi Avro Serializer."
      }
    ]
  },
  {
    id: "tinydb-rust",
    title: "tinydb — Relational Storage Engine Internals in Rust",
    category: "Low-Level Database Internals (CMU 15-445)",
    timeline: "2026",
    summary: "Storage engine quan hệ viết bằng Rust theo chuẩn CMU 15-445: tổ chức slotted page 8KB, heap file, chỉ mục B+Tree, bộ ghi nhật ký WAL ARIES, transaction manager và SQL REPL executor với 38 bài test pass.",
    githubUrl: "https://github.com/tandat8896/tinydb",
    context: "Hiện thực hóa kiến trúc lõi của một hệ quản trị cơ sở dữ liệu quan hệ từ mức byte đĩa cứng, nắm bắt sâu sắc cấu trúc trang lưu trữ, thuật toán cân bằng cây chỉ mục và cơ chế phục hồi giao dịch crash recovery.",
    missions: [
      "Disk Manager tổ chức file dữ liệu thành các trang cố định 8KB (Slotted-Page Architecture) lưu tuple metadata và payload biến thiên.",
      "Buffer Pool Manager kiểm soát bộ nhớ đệm trang với chính sách thay thế tối ưu, đồng bộ trang bẩn (dirty pages).",
      "Index Manager cài đặt cấu trúc B+Tree tự cân bằng hỗ trợ tìm kiếm điểm (Point Query) và duyệt khoảng (Range Scan).",
      "Transaction & Log Manager ghi nhận Write-Ahead Logging (WAL) theo chuẩn ARIES phục hồi dữ liệu khi tiến trình bị ngắt đột ngột.",
      "SQL Lexer, Parser và Executor cho phép tương tác qua terminal REPL với cú pháp chuẩn SQL."
    ],
    results: [
      "Vượt qua 38/38 unit tests và integration tests bao quát các kịch bản đọc/ghi/phục hồi.",
      "Tách biệt hoàn toàn tầng trừu tượng I/O, sẵn sàng mở rộng các thuật toán concurrency control cấp cao."
    ],
    techEnv: [
      "Rust 2021 Edition",
      "CMU 15-445 Standards",
      "8KB Slotted Page",
      "B+Tree Indexing",
      "Write-Ahead Logging (WAL)",
      "ARIES Crash Recovery",
      "SQL Lexer & Parser",
      "Buffer Pool Manager"
    ],
    challenges: [
      {
        problem: "Hiện tượng phân mảnh (fragmentation) và dời offset con trỏ trong trang 8KB khi xóa hoặc cập nhật tuple kích thước biến đổi.",
        solution: "Thiết kế mảng Slot Pointer nằm ở đầu trang trỏ về payload dữ liệu được nạp ngược từ cuối trang lên (two-way growth), thực hiện compaction slot khi tỷ lệ byte trống phân mảnh vượt ngưỡng."
      },
      {
        problem: "Đảm bảo tính toàn vẹn của B+Tree khi tách nốt (split) hoặc gộp nốt (merge) trong môi trường nhiều con trỏ.",
        solution: "Triển khai chặt chẽ cơ chế borrow / redistribute con trỏ giữa các nốt anh em (sibling nodes) trước khi quyết định merge, đảm bảo chiều cao cây cân bằng tuyệt đối."
      }
    ]
  }
];
