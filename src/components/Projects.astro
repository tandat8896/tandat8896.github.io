                <text x="90" y="291" text-anchor="middle" fill="#f87171" font-family="monospace" font-size="7">SSH :22 Blocked</text>
                <text x="90" y="304" text-anchor="middle" fill="#94a3b8" font-family="monospace" font-size="6.5">No direct node access</text>

                <!-- ================= FIREWALL APPLIANCE / SECURITY GATEWAY ================= -->
                <rect x="168" y="90" width="36" height="230" rx="6" fill="#1c0a0a" stroke="#ef4444" stroke-width="1.2"/>
                <rect x="174" y="100" width="24" height="24" rx="4" fill="#991b1b"/>
                <path d="M 186 106 l 7 3 v 6 c 0 5 -4 8 -7 9 c -3 -1 -7 -4 -7 -9 v -6 z" fill="none" stroke="#ffffff" stroke-width="1.4"/>
                <text x="186" y="145" text-anchor="middle" fill="#fca5a5" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="8" font-weight="bold" transform="rotate(-90, 186, 145)">L4 FIREWALL</text>
                <text x="186" y="235" text-anchor="middle" fill="#f87171" font-family="monospace" font-size="7" font-weight="bold" transform="rotate(-90, 186, 235)">ZERO-TRUST</text>

                <!-- ================= SUBNET 2: ORACLE RAC PUBLIC SUBNET ================= -->
                <rect x="220" y="60" width="485" height="316" rx="6" fill="#ea580c" fill-opacity="0.04" stroke="#ea580c" stroke-width="1"/>
                <rect x="230" y="52" width="165" height="16" rx="3" fill="#9a3412"/>
                <text x="312" y="63" text-anchor="middle" fill="#ffedd5" font-family="monospace" font-size="7.5" font-weight="bold">Database Subnet: 10.10.50.0/24</text>

                <!-- SCAN LISTENER (ENTRYPOINT) -->
                <rect x="235" y="76" width="455" height="46" rx="6" fill="#1f1406" stroke="#f59e0b" stroke-width="1.5"/>
                <rect x="245" y="85" width="28" height="28" rx="4" fill="#d97706"/>
                <circle cx="259" cy="99" r="8" fill="none" stroke="#ffffff" stroke-width="1.6"/>
                <path d="M 255 99 h 8 M 259 95 v 8" stroke="#ffffff" stroke-width="1.6"/>
                <text x="282" y="95" fill="#ffffff" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="9.5" font-weight="bold">SCAN LISTENER (Central Virtual Hub)</text>
                <text x="282" y="109" fill="#fde68a" font-family="monospace" font-size="7.8">10.10.50.30:1521 • Hostname: rac-scan.localdomain • Round-Robin TNS REDIRECT</text>

                <!-- AVAILABILITY ZONE 1: racdb1 -->
                <rect x="235" y="132" width="220" height="135" rx="6" fill="#0b1320" stroke="#38bdf8" stroke-width="1.2"/>
