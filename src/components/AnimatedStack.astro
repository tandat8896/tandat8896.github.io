// Double items for seamless infinite marquee loop
const MARQUEE_STREAM = [...CORE_STACK, ...CORE_STACK];
---

<section class="py-16 bg-[#06070a] border-y border-[#151720] overflow-hidden relative" id="skills-section">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-8 text-center">
    <span class="text-xs font-mono uppercase tracking-[3px] text-[#ffbd39] font-bold block mb-1">
      // 12 CORE PRODUCTION TOOLS
    </span>
    <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
      12 Công Cụ Kỹ Thuật Trực Chiến
    </h2>
    <p class="text-xs text-gray-400 mt-1 max-w-xl mx-auto">
      Rê chuột vào biểu tượng để xem vai trò kỹ thuật thực tế trong 4 dự án cốt lõi.
    </p>
  </div>

  <!-- Single Clean, Smooth Infinite Marquee Stream -->
  <div class="marquee-wrapper relative w-full overflow-hidden py-3">
    <div class="marquee-track flex items-center gap-5 w-max">
      {MARQUEE_STREAM.map(item => (
        <div
          class="stack-pill flex items-center gap-3.5 px-4 py-3 rounded-xl bg-[#0b0d13] border border-[#1d212d] hover:border-[#ffbd39] cursor-pointer group transition-all duration-300 select-none shadow-md shadow-black/40 hover:-translate-y-1.5 hover:shadow-xl hover:bg-[#121520]"
          data-role={item.role}
          data-category={item.category}
          data-name={item.name}
          data-color={item.color}
        >
          <div class="w-8 h-8 flex-shrink-0 flex items-center justify-center p-1 rounded-lg bg-black/60 border border-white/5 group-hover:scale-110 transition duration-300">
            <Fragment set:html={item.iconSvg} />
          </div>

          <div class="flex flex-col">
            <div class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full" style={`background-color: ${item.color}`}></span>
              <span class="text-xs font-bold text-white group-hover:text-[#ffbd39] transition whitespace-nowrap">
                {item.name}
              </span>
            </div>
            <span class="text-[10px] font-mono text-gray-400 whitespace-nowrap">
              {item.category}
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Interactive Inspector Card -->
  <div class="max-w-3xl mx-auto px-4 mt-8">
    <div id="stack-inspector" class="p-4 sm:p-5 rounded-xl bg-[#0b0d14] border border-[#1f2433] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 transition duration-300 shadow-2xl">
      <div class="flex items-center gap-3.5">
        <div id="inspector-dot" class="w-3.5 h-3.5 rounded-full bg-[#f80000] animate-pulse flex-shrink-0"></div>
        <div>
          <span id="inspector-cat" class="text-[10px] font-mono uppercase tracking-wider text-[#ffbd39] font-bold block">
            HIGH AVAILABILITY DBA
          </span>
          <h4 id="inspector-name" class="text-base font-bold text-white">
            Oracle 19c RAC
          </h4>
        </div>
      </div>
      <div class="text-xs font-mono text-gray-300 bg-black/70 px-4 py-2.5 rounded-lg border border-white/5 max-w-md w-full sm:w-auto">
        <span class="text-gray-500">Vai trò: </span>
        <span id="inspector-role" class="text-[#ffbd39] font-medium">2-Node Active-Active, ASM Disks &amp; Data Guard FSFO</span>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes marqueeLeft {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .marquee-track {
    animation: marqueeLeft 28s linear infinite;
  }

  .marquee-wrapper:hover .marquee-track {
    animation-play-state: paused;
  }
</style>

<script>
  const pills = document.querySelectorAll(".stack-pill");
  const inspectorName = document.getElementById("inspector-name");
  const inspectorCat = document.getElementById("inspector-cat");
  const inspectorRole = document.getElementById("inspector-role");
  const inspectorDot = document.getElementById("inspector-dot");

  pills.forEach(pill => {
    pill.addEventListener("mouseenter", () => {
      const name = pill.getAttribute("data-name");
      const cat = pill.getAttribute("data-category");
      const role = pill.getAttribute("data-role");
      const color = pill.getAttribute("data-color");

      if (inspectorName) inspectorName.textContent = name || "";
      if (inspectorCat) inspectorCat.textContent = cat || "";
      if (inspectorRole) inspectorRole.textContent = role || "";
      if (inspectorDot && color) {
        inspectorDot.style.backgroundColor = color;
      }
    });
  });
</script>
