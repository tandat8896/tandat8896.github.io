<script>
  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
    const reveal = new IntersectionObserver(entries => entries.forEach(entry => { if (entry.isIntersecting) { entry.target.classList.add("reveal-in"); reveal.unobserve(entry.target); } }), { threshold: 0.08 });
    document.querySelectorAll(".project-index article, .stack-grid article, .about-story").forEach(element => reveal.observe(element));
  }

  const menu = document.querySelector<HTMLButtonElement>(".portfolio .menu-button");
  const navigation = document.getElementById("portfolio-nav");
  function closeMenu(){menu?.setAttribute("aria-expanded","false");navigation?.classList.remove("is-open");}
  menu?.addEventListener("click",()=>{const open=menu.getAttribute("aria-expanded")!=="true";menu.setAttribute("aria-expanded",String(open));navigation?.classList.toggle("is-open",open);});
  navigation?.querySelectorAll("a").forEach(link=>link.addEventListener("click",closeMenu));
  document.addEventListener("keydown",event=>{if(event.key==="Escape")closeMenu();});
  document.querySelectorAll<HTMLAnchorElement>("[data-open-drawing]").forEach(link=>link.addEventListener("click",()=>{const id=link.dataset.openDrawing;document.querySelector<HTMLButtonElement>(`[data-arch-tab="${id}"]`)?.click();}));
</script>
