---
import Architecture from "./Architecture.astro";
import PortfolioCredentials from "./PortfolioCredentials.astro";
import PortfolioTerminal from "./PortfolioTerminal.astro";
interface Props { showArchitecture?: boolean; }
const { showArchitecture = true } = Astro.props;
const projects = [
  { id: "oracle-rac", number: "01", category: "Database reliability", name: "Oracle RAC & Data Guard", text: "Active-active, shared ASM và physical standby. Từ cài đặt đến failover, backup và query tuning.", video: "https://www.youtube.com/watch?v=-eH738r5fRQ", icon: "oracle", tags: "Oracle 19c / ASM / FSFO", github: "https://github.com/tandat8896/oracle-rac-data-guard-lab" },
  { id: "hadoop-spark", number: "02", category: "Distributed infrastructure", name: "Hadoop & Spark HA", text: "Cụm ba VM, hai mạng compute/storage và lớp điều phối HA cho NameNode, Spark master.", icon: "spark", tags: "HDFS / Spark / ZooKeeper", github: "https://github.com/tandat8896/oracle-rac-data-guard-lab" },
  { id: "medallion-nix", number: "03", category: "Data platform engineering", name: "Medallion Platform on Nix", status: "Local lab · còn phần cần hoàn thiện", text: "Kafka / Flink nạp Bronze; Spark xử lý Silver và Gold Parquet. Có architecture, tutorial, migration và loader PostgreSQL; lượt nạp Gold còn chờ xác nhận.", icon: "flink", tags: "Kafka / Flink / Spark / Nix", github: "https://github.com/tandat8896/standard-medallion-apache-ecosystem-on-nix" },
  { id: "solar-pv", number: "04", category: "Data & AI · graduation project", name: "Solar PV Analytics & Forecasting", role: "Data & AI Lead · The Outliers", evidence: "Xem dashboard & kết quả", resultsId: "solar-results", text: "Pipeline dữ liệu điện mặt trời, phát hiện ngoại lai và dự báo sản lượng. Dashboard phân tích và giải thích mô hình.", icon: "python", tags: "Python / PostgreSQL / LightGBM", github: "https://github.com/tandat8896/datn_outlier_hs_nlmt" },
];
const stacks = [
  { title: "Database & recovery", items: "Oracle RAC · ASM · Data Guard · RMAN · PostgreSQL", detail: "Cấu hình, quan sát, backup và phục hồi." },
  { title: "Data platforms", items: "Hadoop · Spark · Kafka · Debezium · Iceberg", detail: "Dữ liệu đi đâu, được xử lý và lưu như thế nào." },
  { title: "Data science & tooling", items: "Python · LightGBM · Optuna · SHAP · Tableau · Neovim · Nix", detail: "Phân tích, dự báo và giải thích kết quả; môi trường xử lý tái lập." },
];
---
<div class="portfolio">
  <a class="skip-link" href="#main-content">Bỏ qua menu, đến nội dung</a>
  <header class="site-nav">
    <a href="#home-section" class="wordmark" aria-label="Ngô Tấn Đạt — trang đầu"><span class="monogram">đ.</span><span>NGÔ TẤN ĐẠT<span class="wordmark-sub">DATABASE &amp; DATA SYSTEMS</span></span></a>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="portfolio-nav">Menu <span>+</span></button>
    <nav id="portfolio-nav" aria-label="Điều hướng chính"><a href="#projects-section">Projects</a><a href="#skills-section">Expertise</a><a href="#about-section">About</a><a href="#resume-section">Certificates</a><a class="nav-contact" href="#contact-section">Let’s talk <span>↗</span></a></nav>
  </header>
  <main id="main-content">
    <section class="hero wrap" id="home-section">
      <div class="hero-copy"><p class="eyebrow"><span class="status-dot"></span> ORACLE DBA &amp; DATA ENGINEERING</p><h1>Behind the data.<br /><em>Inside the system.</em></h1><p class="hero-description">Mình là <strong>Ngô Tấn Đạt</strong>. Mình xây dựng và tìm hiểu các hệ thống dữ liệu — từ cụm Oracle có tính sẵn sàng cao đến hạ tầng phân tán và pipeline dữ liệu.</p><div class="hero-actions"><a class="button-primary" href="#projects-section">Khám phá project <span>↘</span></a><a class="text-link demo-cta" href="https://www.youtube.com/watch?v=-eH738r5fRQ" target="_blank" rel="noopener noreferrer"><span aria-hidden="true">▷</span> Xem demo Oracle</a></div><div class="hero-note"><span>Based in Ho Chi Minh City, Vietnam</span><span>Code. Observe. Understand.</span></div><PortfolioTerminal /></div>
      <figure class="portrait"><div class="portrait-meta"><span>ENGINEER.PROFILE</span><span>HCMC / VN</span></div><div class="portrait-frame"><img src="/assets/profile.jpg" alt="Ngô Tấn Đạt" width="1062" height="1280" fetchpriority="high" /><span class="portrait-index">FIELD NOTES / 2026</span><span class="portrait-crosshair" aria-hidden="true">+</span></div><figcaption><span>Ngô Tấn Đạt</span><span>Build → inspect → document</span></figcaption><div class="profile-domains"><span>DATABASES</span><span>DISTRIBUTED SYSTEMS</span><span>STORAGE</span></div></figure>
    </section>
    <section class="projects wrap" id="projects-section">
      <div class="section-head"><div><p class="eyebrow">01 / SELECTED WORK</p><h2>Built to be <em>understood.</em></h2></div><p>Project có source code, sơ đồ và ghi chép thực nghiệm.<br />Bắt đầu từ kiến trúc, đi sâu vào cách hệ thống hoạt động.</p></div>
      <div class="project-index">{projects.map(project => <article id={`project-${project.id}`}><div class="project-top"><span>{project.number} / {project.category}</span><img src={`/architecture/icons/${project.icon}.svg`} alt="" width="44" height="36" /></div><h3><a href={showArchitecture ? "#arch-architecture-section" : project.github} data-open-drawing={showArchitecture ? project.id : undefined}>{project.name}<span>↗</span></a></h3>{project.video && <a class="project-video" href={project.video} target="_blank" rel="noopener noreferrer"><span aria-hidden="true">▶</span> Xem video demo · kết quả thực nghiệm <span aria-hidden="true">↗</span></a>}{project.role && <span class="project-role">{project.role}</span>}{project.evidence && <a class="project-evidence" href={showArchitecture ? "#arch-architecture-section" : project.github} data-open-drawing={showArchitecture ? project.resultsId : undefined}>{project.evidence} ↗</a>}{project.status && <span class="project-status">{project.status}</span>}<p>{project.text}</p><div class="project-bottom"><span>{project.tags}</span><a href={project.github} target="_blank" rel="noopener noreferrer" aria-label={`Source code ${project.name}`}>Source ↗</a></div></article>)}</div>
      {showArchitecture && <div class="atlas"><div class="atlas-heading"><span class="eyebrow">ARCHITECTURE / 06 SHEETS + RESULTS</span><span>Chọn project · xem luồng · mở khổ lớn</span></div><Architecture comparison={false} /></div>}
    </section>
    <section class="expertise" id="skills-section"><div class="wrap"><div class="section-head"><div><p class="eyebrow">02 / ENGINEERING TOOLKIT</p><h2>Depth before <em>decoration.</em></h2></div><p>Những công cụ mình sử dụng để xây lab,<br />đọc hành vi hệ thống và kiểm chứng thiết kế.</p></div><div class="stack-grid">{stacks.map((stack,i)=><article><span class="stack-number">0{i+1}</span><h3>{stack.title}</h3><p class="stack-items">{stack.items}</p><p>{stack.detail}</p></article>)}</div><div class="logo-line" aria-label="Một số công nghệ sử dụng">{["oracle","postgresql","spark","hadoop","kafka","nixos"].map(icon=><img src={`/architecture/icons/${icon}.svg`} alt={icon} width="70" height="42" loading="lazy" />)}</div></div></section>
    <section class="about wrap" id="about-section"><div class="about-story"><p class="eyebrow">03 / A LITTLE CONTEXT</p><h2>Hiểu đến gốc.<br /><em>Làm đến nơi.</em></h2><p>Mình quan tâm đến điều xảy ra phía sau một câu truy vấn: execution plan, bộ nhớ, I/O, replication và những tình huống hệ thống không chạy như dự kiến.</p><p>Homelab là nơi mình dựng cụm, thử nghiệm và ghi lại bài học. Các sơ đồ ở đây đi cùng code và runbook để người đọc có thể lần theo từng quyết định kỹ thuật.</p><a class="text-link" href="https://www.linkedin.com/in/dat-tan-858549387/" target="_blank" rel="noopener noreferrer">Kết nối trên LinkedIn ↗</a></div><div class="timeline" id="resume-section"><article><span class="timeline-date">2024 — NOW</span><h3>Independent systems lab</h3><p>Oracle RAC, Data Guard, query tuning và distributed data systems. Xây dựng lab, thử nghiệm và viết runbook.</p></article><article><span class="timeline-date">05 — 08 / 2026</span><h3>Software Engineering Intern</h3><span class="timeline-place">Phan Khang Home</span><p>Phát triển backend và REST APIs cho CMS; làm việc với schema, truy vấn và tài liệu kỹ thuật.</p></article><PortfolioCredentials /><article><span class="timeline-date">EDUCATION / 2026</span><h3>FPT Polytechnic</h3><p>Công nghệ thông tin — chuyên ngành Xử lý dữ liệu.</p></article></div></section>
    <section class="contact" id="contact-section"><div class="wrap"><p class="eyebrow">04 / GET IN TOUCH</p><div class="contact-main"><h2>Good systems start<br />with a <em>conversation.</em></h2><div><p>Trao đổi về Oracle, data engineering<br />hoặc một cơ hội cùng làm việc.</p><a class="contact-email" href="mailto:tandat88963820@gmail.com">tandat88963820@gmail.com <span>↗</span></a></div></div><div class="contact-bottom"><span>Ho Chi Minh City · Vietnam</span><div><a href="https://github.com/tandat8896" target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href="https://www.linkedin.com/in/dat-tan-858549387/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href="tel:0984555752">0984 555 752</a></div></div></div></section>
  </main>
  <footer class="wrap"><span>© {new Date().getFullYear()} Ngô Tấn Đạt</span><span>Crafted with care. Documented with evidence.</span><a href="#home-section">Back to top ↑</a></footer>
</div>
<style>
  #resume-section { scroll-margin-top:95px; }
  @media(prefers-reduced-motion:no-preference){.project-index article:hover{box-shadow:inset 0 3px #798d6b}.reveal-in{animation:reveal-in .55s ease-out both}.button-primary{transition:background .2s,transform .2s}.button-primary:hover{transform:translateY(-2px)}@keyframes reveal-in{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}

  .project-role{display:block;margin-top:12px;font:500 11px 'IBM Plex Mono',monospace;color:#38512f}.project-evidence{display:inline-block;font-size:11px;color:var(--accent)!important;margin-top:10px;border-bottom:1px solid #c6b898}
  .project-video { display:inline-flex;align-items:center;gap:8px;padding:10px 12px;margin-top:15px;border:1px solid #557442;background:#dce9cd;color:#28411f!important;font:500 11px/1.6 'IBM Plex Mono',monospace; }.project-video:hover{background:#dce7cf}.demo-cta{white-space:nowrap}.demo-cta>span{font-size:17px;margin-right:5px}
  .project-status { display: inline-block; margin: 12px 0 0; padding: 4px 9px; border: 1px solid #dcc6a4; background: #fff5e4; color: #77470f; font-size: 11px; font-weight: 600; }
  .hero { position:relative;background-image:linear-gradient(#71806a0b 1px,transparent 1px),linear-gradient(90deg,#71806a0b 1px,transparent 1px);background-size:40px 40px; }
  .hero::before,.hero::after { position:absolute;font:18px 'IBM Plex Mono',monospace;color:#9aa88f;pointer-events:none; }.hero::before{content:'+';left:-8px;top:23px}.hero::after{content:'+';right:-8px;bottom:20px}
  .portrait-meta { display:flex;justify-content:space-between;margin-bottom:11px;font:8px 'IBM Plex Mono',monospace;letter-spacing:1.2px;color:var(--muted); }
  .portrait-crosshair { position:absolute;top:12px;right:16px;color:#fff;font:25px 'IBM Plex Mono',monospace;text-shadow:0 1px 4px #0006; }
  .profile-domains { display:flex;gap:7px;flex-wrap:wrap;margin-top:14px; }.profile-domains span { font:7px 'IBM Plex Mono',monospace;letter-spacing:.6px;border:1px solid var(--line);background:var(--paper);padding:4px 6px; }
  .portfolio { --ink:#243a32;--muted:#64736d;--paper:#f6f5f0;--line:#d5dad1;--accent:#a45429; background:var(--paper);color:var(--ink);font-family:'Manrope','DejaVu Sans',sans-serif;overflow:clip; }
  .portfolio h1,.portfolio h2,.portfolio h3,.portfolio p { margin:0; }
  .portfolio h1,.portfolio h2,.portfolio h3 { font-family:inherit;color:var(--ink); }
  .portfolio a { color:inherit;text-decoration:none; }
  .portfolio a:hover { color:var(--accent); }
  .wrap { width:min(1320px,calc(100% - 112px));margin-inline:auto; }
  .eyebrow { font-family:monospace;font-size:11px;letter-spacing:1.9px;font-weight:500;line-height:1.6;color:var(--accent); }
  .skip-link { position:fixed;top:-100px;left:20px;z-index:100;background:#fff;padding:12px; }.skip-link:focus{top:10px}
  .site-nav { width:min(1440px,100%);margin:auto;min-height:98px;display:flex;align-items:center;justify-content:space-between;gap:30px;padding:0 56px;border-bottom:1px solid var(--line); }
  .wordmark { display:flex;align-items:center;gap:13px;font-size:12px;letter-spacing:1.2px;font-weight:800;line-height:1.5; }
  .monogram { font-family:'DM Serif Display',Georgia,serif;font-size:47px;font-weight:400;letter-spacing:-4px;padding-right:5px; }
  .wordmark-sub { display:block;font-family:monospace;font-size:8px;letter-spacing:1.2px;color:var(--muted);font-weight:400; }
  .site-nav nav { display:flex;align-items:center;gap:36px;font-size:12px; }
  .nav-contact { border:1px solid var(--ink);padding:9px 18px; }.nav-contact span{margin-left:20px}.menu-button{display:none}
  .hero { display:grid;grid-template-columns:1.5fr 1fr;align-items:center;gap:8%;padding-block:85px 70px;min-height:710px; }
  .hero .eyebrow{display:flex;align-items:center;gap:9px}.status-dot{height:6px;width:6px;background:var(--accent);border-radius:50%}
  .hero h1 { font-size:clamp(38px,4.6vw,67px);font-weight:500;line-height:1.12;letter-spacing:-2.6px;margin-top:28px; }
  .portfolio em { font-family:'DM Serif Display',Georgia,serif;font-weight:400;color:#657761; }
  .hero-description { font-size:14px;color:var(--muted);max-width:535px;margin-top:28px!important;line-height:1.95; }.hero-description strong{color:var(--ink);font-weight:700}
  .hero-actions{display:flex;align-items:center;gap:28px;margin-top:30px}.button-primary{background:var(--ink);color:#fff!important;padding:15px 22px;font-size:12px;display:inline-flex;gap:45px;align-items:center}.button-primary:hover{background:#385748}.text-link{font-size:12px;border-bottom:1px solid #aeb9af;padding-bottom:3px}
  .hero-note{display:flex;gap:20px;flex-wrap:wrap;margin-top:47px;font-family:monospace;font-size:9px;letter-spacing:.1px;color:var(--muted)}
  .portrait{margin:0;position:relative;padding-left:22px}.portrait::before{content:'';position:absolute;inset:20px 16px 10px 0;border:1px solid #b1bcb0;pointer-events:none}.portrait-frame{position:relative;background:#d8ddce;aspect-ratio:4/4.6;overflow:hidden}.portrait img{width:100%;height:100%;object-fit:cover;object-position:center 37%;filter:saturate(.7);display:block}.portrait-index{position:absolute;bottom:16px;left:18px;writing-mode:vertical-rl;transform:rotate(180deg);color:white;font-family:monospace;font-size:9px;letter-spacing:2px;text-shadow:0 1px 5px #000}.portrait figcaption{position:relative;display:flex;justify-content:space-between;gap:10px;font-size:9px;background:var(--paper);padding-top:16px;color:var(--muted)}
  .projects{padding-block:85px}.section-head{display:flex;justify-content:space-between;align-items:flex-end;gap:40px;margin-bottom:35px}.section-head h2{font-size:clamp(28px,3.2vw,44px);letter-spacing:-1.4px;line-height:1.2;font-weight:500;margin-top:15px}.section-head>p{font-size:12px;color:var(--muted);line-height:1.9;padding-bottom:3px}
  .project-index{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border-top:1px solid var(--line);border-left:1px solid var(--line)}.project-index article{padding:27px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);transition:background .2s}.project-index article:hover{background:#eeeee5}.project-top{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-bottom:18px}.project-top>span{font-family:monospace;font-size:10px;color:var(--muted)}.project-top img{object-fit:contain}.project-index h3{font-size:20px;font-weight:600;letter-spacing:-.6px}.project-index h3 a{display:flex;justify-content:space-between;gap:20px}.project-index h3 span{color:#9aa893;font-size:24px;font-weight:400}.project-index article>p{font-size:12px;color:var(--muted);line-height:1.9;margin-top:12px}.project-bottom{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-top:23px;font-family:monospace;font-size:9px;color:var(--muted)}.project-bottom a{color:var(--accent);white-space:nowrap}
  .atlas{margin-top:45px}.atlas-heading{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:16px}.atlas-heading>span:last-child{font-size:10px;color:var(--muted)}
  .expertise{background:#ebeee6;padding-block:72px;border-block:1px solid var(--line)}.stack-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:42px}.stack-grid article{padding-top:22px;border-top:1px solid #c3cbbf}.stack-number{font-family:monospace;font-size:10px;color:#7b8c72}.stack-grid h3{font-size:19px;font-weight:600;margin:12px 0}.stack-grid p{font-size:11px;color:var(--muted)}.stack-grid .stack-items{font-size:12px;color:var(--ink);line-height:1.9;min-height:50px;margin-bottom:14px}.logo-line{display:flex;justify-content:space-between;gap:35px;align-items:center;margin-top:45px;padding-top:28px;border-top:1px solid #cbd2c6}.logo-line img{object-fit:contain;max-width:11%;opacity:.8}
  .about{display:grid;grid-template-columns:1fr 1.05fr;gap:12%;padding-block:90px}.about h2{font-size:48px;line-height:1.17;font-weight:500;letter-spacing:-1.5px;margin:20px 0 28px}.about-story>p:not(.eyebrow){font-size:13px;line-height:1.95;color:var(--muted);margin-bottom:18px}.about-story>a{display:inline-block;margin-top:12px}.timeline{border-left:1px solid var(--line);padding-left:30px}.timeline article{position:relative;padding-bottom:26px;margin-bottom:24px;border-bottom:1px solid var(--line)}.timeline article:last-child{margin-bottom:0}.timeline article::before{content:'';position:absolute;left:-35px;top:5px;width:9px;height:9px;border:1px solid #97a48d;background:var(--paper)}.timeline-date{font:9px monospace;letter-spacing:1px;color:var(--accent)}.timeline h3{font-size:16px;font-weight:600;margin:9px 0 5px}.timeline p,.timeline-place{font-size:12px;color:var(--muted);line-height:1.85}.timeline-place{display:block;margin-bottom:9px}.credential a{font-size:11px;color:var(--accent)}
  .contact{background:#20382f;color:#ebeee5;padding-block:62px 25px}.contact .eyebrow{color:#bac8a4}.contact-main{display:grid;grid-template-columns:1.2fr 1fr;align-items:end;gap:60px;margin-top:25px}.contact h2{color:#f4f4e9;font-size:clamp(32px,3.8vw,52px);font-weight:400;line-height:1.15;letter-spacing:-1.3px}.contact h2 em{color:#bac8a4}.contact-main p{font-size:12px;color:#b7c5bb;line-height:1.9}.contact-email{display:flex;gap:20px;justify-content:space-between;align-items:center;font-size:clamp(13px,1.6vw,21px);margin-top:20px;padding-bottom:10px;border-bottom:1px solid #6e8073;overflow-wrap:anywhere}.contact a:hover{color:#d7cfaa}.contact-bottom{display:flex;justify-content:space-between;gap:20px;border-top:1px solid #42594b;margin-top:50px;padding-top:22px;font-family:monospace;font-size:10px;color:#b6c4b9}.contact-bottom>div{display:flex;gap:25px}
  footer{display:flex;justify-content:space-between;gap:20px;padding-block:24px;font-family:monospace;font-size:9px;color:var(--muted)}
  @media(min-width:1500px){.hero{min-height:760px}.portrait{max-width:420px;justify-self:end}}
  @media(max-width:1050px){.wrap{width:calc(100% - 60px)}.site-nav{padding:0 30px}.hero{gap:5%;padding-block:60px;min-height:620px}.hero h1{font-size:45px}.section-head{align-items:flex-start;gap:25px}.section-head>p br{display:none}.section-head>p{max-width:290px}.about{gap:7%}.contact-main{gap:35px}.project-bottom{flex-wrap:wrap}.focus-strip p{gap:25px;font-size:25px}}
