---
// Technology logos matching ftco-partner on jijun-tang.github.io
---

<section class="py-16 bg-[#050505] border-t border-[#141414]" id="skills-section">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="heading-section text-center mb-12">
      <h1 class="big">Skills</h1>
      <span class="subheading">TECH STACK &amp; TOOLS</span>
      <h2 class="mb-4">Technology Stack</h2>
      <p class="text-gray-400 text-sm max-w-2xl mx-auto">
        Các công nghệ cốt lõi được ứng dụng trực tiếp trong quản trị cơ sở dữ liệu doanh nghiệp, tối ưu hoá hiệu năng và xây dựng nền tảng dữ liệu phân tán.
      </p>
    </div>

    <!-- Row 1: Languages -->
    <div class="mb-8">
      <h3 class="text-center text-xs font-mono uppercase tracking-widest text-[#ffbd39] mb-4">
        — Programming &amp; Systems Languages —
      </h3>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-4 items-center justify-center">
        <!-- Python -->
        <div class="flex flex-col items-center justify-center p-4 rounded-lg bg-[#0c0d11] border border-[#1a1c24] hover:border-[#ffbd39] transition group">
          <svg class="w-10 h-10 mb-2 group-hover:scale-110 transition" viewBox="0 0 128 128">
            <path fill="#3776AB" d="M63.4 4c-15.6 0-25 6.9-25 19.5v14.3h25.7v3.6H26.3C11.8 41.4 0 50.8 0 65.7c0 14.8 11.2 24 25.7 24h7.9v-11.4c0-13.6 11.8-24.8 25.7-24.8h25.4c11.4 0 20.7-9.5 20.7-20.9V19.5C104.4 6.9 94.6 4 79 4H63.4zm-7.6 7.4c2.8 0 5.1 2.3 5.1 5.2s-2.3 5.2-5.1 5.2c-2.8 0-5.1-2.3-5.1-5.2s2.3-5.2 5.1-5.2z"/>
            <path fill="#FFD43B" d="M64.6 124c15.6 0 25-6.9 25-19.5V90.2H63.9v-3.6h37.8c14.5 0 26.3-9.4 26.3-24.3 0-14.8-11.2-24-25.7-24h-7.9v11.4c0 13.6-11.8 24.8-25.7 24.8H43.8c-11.4 0-20.7 9.5-20.7 20.9v13.1c0 12.6 9.8 15.5 25.4 15.5h16.1zm7.6-7.4c-2.8 0-5.1-2.3-5.1-5.2s2.3-5.2 5.1-5.2c2.8 0 5.1 2.3 5.1 5.2s-2.3 5.2-5.1 5.2z"/>
          </svg>
          <span class="text-xs font-bold text-gray-200 group-hover:text-[#ffbd39] transition">Python</span>
        </div>

        <!-- Rust -->
        <div class="flex flex-col items-center justify-center p-4 rounded-lg bg-[#0c0d11] border border-[#1a1c24] hover:border-[#ffbd39] transition group">
          <svg class="w-10 h-10 mb-2 group-hover:scale-110 transition" viewBox="0 0 128 128" fill="#DEA584">
            <path d="M64 6.6c-31.7 0-57.4 25.7-57.4 57.4 0 31.7 25.7 57.4 57.4 57.4s57.4-25.7 57.4-57.4c0-31.7-25.7-57.4-57.4-57.4zm0 8.2c27.2 0 49.2 22 49.2 49.2s-22 49.2-49.2 49.2-49.2-22-49.2-49.2 22-49.2 49.2-49.2zm-22.3 22.8c-2.3 0-4.1 1.9-4.1 4.1v44.6c0 2.3 1.9 4.1 4.1 4.1h8.2v-20.5h8.2l10.2 20.5h10.2l-12.3-24.6c6.1-2 10.2-8.2 10.2-14.3 0-8.2-6.1-13.9-16.4-13.9H41.7zm8.2 8.2h10.2c4.1 0 6.1 2 6.1 6.1s-2 6.1-6.1 6.1H49.9V45.8z"/>
          </svg>
          <span class="text-xs font-bold text-gray-200 group-hover:text-[#ffbd39] transition">Rust</span>
        </div>

        <!-- Java -->
        <div class="flex flex-col items-center justify-center p-4 rounded-lg bg-[#0c0d11] border border-[#1a1c24] hover:border-[#ffbd39] transition group">
          <svg class="w-10 h-10 mb-2 group-hover:scale-110 transition" viewBox="0 0 128 128" fill="#E76F00">
            <path d="M46.7 93.3c0 0-4.8 2.8 3.5 3.8 9.9 1.1 15.7 1 27.2-.9 0 0 3.8 2.4 8.9 4.5-28.7 11.7-54-1.2-39.6-7.4zm-2.4-13.8c0 0-5.3 3.9 3.8 5 11 1.3 22.1 1.4 37.1-1.3 0 0 2.6 2.7 6.9 4.3-34.8 10.8-63.5.7-47.8-8zm24.5-27.1c4.5 5.2 1.2 9.9-1.2 13.9-6.9 11.2-1.9 17.6 9.4 17.6 8.3 0 15.3-4.1 15.3-4.1s-2.2 3.1-6.7 5.6c-8.9 4.9-25.7 4.1-30.8-7.3-3.6-8.2-.5-14.4 4.5-20.2 4.1-4.7 5.5-8.4 9.5-5.5z"/>
          </svg>
          <span class="text-xs font-bold text-gray-200 group-hover:text-[#ffbd39] transition">Java</span>
        </div>

        <!-- Scala -->
        <div class="flex flex-col items-center justify-center p-4 rounded-lg bg-[#0c0d11] border border-[#1a1c24] hover:border-[#ffbd39] transition group">
          <svg class="w-10 h-10 mb-2 group-hover:scale-110 transition" viewBox="0 0 128 128" fill="#DC322F">
            <path d="M20 20h20v88H20zm34 20h20v68H54zm34 20h20v48H88z"/>
          </svg>
          <span class="text-xs font-bold text-gray-200 group-hover:text-[#ffbd39] transition">Scala</span>
        </div>

        <!-- SQL / PL-SQL -->
        <div class="flex flex-col items-center justify-center p-4 rounded-lg bg-[#0c0d11] border border-[#1a1c24] hover:border-[#ffbd39] transition group">
          <svg class="w-10 h-10 mb-2 group-hover:scale-110 transition" viewBox="0 0 128 128" fill="#00758F">
            <path d="M64 10C35.3 10 12 20.7 12 34v60c0 13.3 23.3 24 52 24s52-10.7 52-24V34c0-13.3-23.3-24-52-24zm0 12c22.1 0 40 7.2 40 12s-17.9 12-40 12-40-7.2-40-12 17.9-12 40-12zm40 72c0 4.8-17.9 12-40 12s-40-7.2-40-12V78.2c9.5 5.9 23.8 9.8 40 9.8s30.5-3.9 40-9.8V94zm0-24c0 4.8-17.9 12-40 12s-40-7.2-40-12V54.2c9.5 5.9 23.8 9.8 40 9.8s30.5-3.9 40-9.8V70z"/>
          </svg>
          <span class="text-xs font-bold text-gray-200 group-hover:text-[#ffbd39] transition">SQL / PL-SQL</span>
        </div>

        <!-- Bash / Linux Shell -->
        <div class="flex flex-col items-center justify-center p-4 rounded-lg bg-[#0c0d11] border border-[#1a1c24] hover:border-[#ffbd39] transition group">
          <svg class="w-10 h-10 mb-2 group-hover:scale-110 transition" viewBox="0 0 128 128" fill="#4EAA25">
            <path d="M10 20h108v88H10z" fill="#1e1e1e"/>
            <path d="M28 44l20 20-20 20M56 84h32" stroke="#4EAA25" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          </svg>
          <span class="text-xs font-bold text-gray-200 group-hover:text-[#ffbd39] transition">Bash / Shell</span>
        </div>
      </div>
    </div>

    <!-- Row 2: Database & Big Data Platforms -->
    <div class="mb-8">
      <h3 class="text-center text-xs font-mono uppercase tracking-widest text-[#ffbd39] mb-4">
        — Enterprise Databases &amp; Distributed Streaming —
      </h3>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-4 items-center justify-center">
        <!-- Oracle Database -->
        <div class="flex flex-col items-center justify-center p-4 rounded-lg bg-[#0c0d11] border border-[#1a1c24] hover:border-[#ffbd39] transition group">
          <svg class="w-10 h-10 mb-2 group-hover:scale-110 transition" viewBox="0 0 128 128" fill="#F80000">
            <path d="M43.2 26C19.3 26 0 43.1 0 64s19.3 38 43.2 38h41.6c23.9 0 43.2-17.1 43.2-38s-19.3-38-43.2-38H43.2zm0 18.2h41.6c13.7 0 24.8 8.9 24.8 19.8s-11.1 19.8-24.8 19.8H43.2c-13.7 0-24.8-8.9-24.8-19.8s11.1-19.8 24.8-19.8z"/>
          </svg>
          <span class="text-xs font-bold text-gray-200 group-hover:text-[#ffbd39] transition">Oracle RAC 19c</span>
        </div>

        <!-- PostgreSQL -->
        <div class="flex flex-col items-center justify-center p-4 rounded-lg bg-[#0c0d11] border border-[#1a1c24] hover:border-[#ffbd39] transition group">
          <svg class="w-10 h-10 mb-2 group-hover:scale-110 transition" viewBox="0 0 128 128" fill="#336791">
            <path d="M63.4 12c-27 0-48.9 21.9-48.9 48.9 0 23.3 16.3 42.8 38.3 47.6v-22.3h-7.6v-12.7h7.6v-9.6c0-10.4 6.3-16.1 15.6-16.1 4.5 0 8.3.3 9.4.5v10.9h-6.5c-5 0-6 2.4-6 5.9v8.4h12.1l-1.6 12.7H65.8v22.7c22.9-4.1 40.1-23.9 40.1-47.9 0-27-21.9-48.9-48.9-48.9z"/>
          </svg>
          <span class="text-xs font-bold text-gray-200 group-hover:text-[#ffbd39] transition">PostgreSQL 17</span>
        </div>

        <!-- Apache Spark -->
        <div class="flex flex-col items-center justify-center p-4 rounded-lg bg-[#0c0d11] border border-[#1a1c24] hover:border-[#ffbd39] transition group">
          <svg class="w-10 h-10 mb-2 group-hover:scale-110 transition" viewBox="0 0 128 128" fill="#E25A1C">
            <path d="M72.4 10l-14 36.6-32.8 11.4 30.6 16.2 3.4 34.6 22-26.6 34.4 7.2-22.4-26.8 12.8-32.4-34 9.8z"/>
          </svg>
          <span class="text-xs font-bold text-gray-200 group-hover:text-[#ffbd39] transition">Apache Spark 3.5</span>
        </div>

        <!-- Apache Kafka -->
        <div class="flex flex-col items-center justify-center p-4 rounded-lg bg-[#0c0d11] border border-[#1a1c24] hover:border-[#ffbd39] transition group">
          <svg class="w-10 h-10 mb-2 group-hover:scale-110 transition" viewBox="0 0 128 128" fill="#231F20">
            <circle cx="64" cy="64" r="54" fill="#ffffff"/>
            <path d="M48 38v52l36-26z" fill="#231F20"/>
          </svg>
          <span class="text-xs font-bold text-gray-200 group-hover:text-[#ffbd39] transition">Apache Kafka</span>
        </div>

        <!-- Apache Flink -->
        <div class="flex flex-col items-center justify-center p-4 rounded-lg bg-[#0c0d11] border border-[#1a1c24] hover:border-[#ffbd39] transition group">
          <svg class="w-10 h-10 mb-2 group-hover:scale-110 transition" viewBox="0 0 128 128" fill="#E6526F">
            <circle cx="64" cy="64" r="54" fill="#E6526F"/>
            <path d="M38 48c8-12 24-12 32 0l18 32-16 10-18-24-16 14z" fill="#ffffff"/>
          </svg>
          <span class="text-xs font-bold text-gray-200 group-hover:text-[#ffbd39] transition">Apache Flink 1.19</span>
        </div>

        <!-- Apache Iceberg -->
        <div class="flex flex-col items-center justify-center p-4 rounded-lg bg-[#0c0d11] border border-[#1a1c24] hover:border-[#ffbd39] transition group">
          <svg class="w-10 h-10 mb-2 group-hover:scale-110 transition" viewBox="0 0 128 128" fill="#42B883">
            <path d="M64 14L20 90h88z" fill="#38BDF8"/>
            <path d="M64 14l20 76H44z" fill="#0284C7"/>
          </svg>
          <span class="text-xs font-bold text-gray-200 group-hover:text-[#ffbd39] transition">Apache Iceberg</span>
        </div>
      </div>
    </div>

    <!-- Row 3: Infrastructure, OS & DevOps -->
    <div>
      <h3 class="text-center text-xs font-mono uppercase tracking-widest text-[#ffbd39] mb-4">
        — Operating Systems &amp; Infrastructure Automation —
      </h3>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-4 items-center justify-center">
        <!-- Linux (Oracle / Rocky) -->
        <div class="flex flex-col items-center justify-center p-4 rounded-lg bg-[#0c0d11] border border-[#1a1c24] hover:border-[#ffbd39] transition group">
          <svg class="w-10 h-10 mb-2 group-hover:scale-110 transition" viewBox="0 0 128 128" fill="#FCC624">
            <circle cx="64" cy="64" r="54" fill="#000000" stroke="#FCC624" stroke-width="4"/>
            <path d="M64 24c-11 0-20 9-20 20 0 14 7 24 10 32H50v8h28v-8h-4c3-8 10-18 10-32 0-11-9-20-20-20z" fill="#FCC624"/>
          </svg>
          <span class="text-xs font-bold text-gray-200 group-hover:text-[#ffbd39] transition">Oracle Linux UEK</span>
        </div>

        <!-- QEMU / KVM -->
        <div class="flex flex-col items-center justify-center p-4 rounded-lg bg-[#0c0d11] border border-[#1a1c24] hover:border-[#ffbd39] transition group">
          <svg class="w-10 h-10 mb-2 group-hover:scale-110 transition" viewBox="0 0 128 128" fill="#FF6600">
            <rect x="20" y="24" width="88" height="60" rx="8" fill="#1e1e1e" stroke="#FF6600" stroke-width="6"/>
            <path d="M44 96l-8 16h56l-8-16" stroke="#FF6600" stroke-width="6" stroke-linecap="round"/>
          </svg>
          <span class="text-xs font-bold text-gray-200 group-hover:text-[#ffbd39] transition">QEMU / KVM</span>
        </div>

        <!-- Nix Flakes -->
        <div class="flex flex-col items-center justify-center p-4 rounded-lg bg-[#0c0d11] border border-[#1a1c24] hover:border-[#ffbd39] transition group">
          <svg class="w-10 h-10 mb-2 group-hover:scale-110 transition" viewBox="0 0 128 128" fill="#5277C3">
            <path d="M64 12l16 28-8 14-8-14-8 14-8-14zm32 40l16 28-16 8-8-14 1-16zm-64 0l7 6-8 14-16-8zm16 48l16 16-8 8-16-8zm32 0l8 16-16 8-8-8z"/>
          </svg>
          <span class="text-xs font-bold text-gray-200 group-hover:text-[#ffbd39] transition">Nix Flakes</span>
        </div>

        <!-- Docker -->
        <div class="flex flex-col items-center justify-center p-4 rounded-lg bg-[#0c0d11] border border-[#1a1c24] hover:border-[#ffbd39] transition group">
          <svg class="w-10 h-10 mb-2 group-hover:scale-110 transition" viewBox="0 0 128 128" fill="#2496ED">
            <path d="M120 58c-3-2-10-2-14 2-1-7-7-12-14-12h-4c-2-8-9-14-17-14v6h-10v-6H51v6H41v-6H31v14H18c-2 0-4 2-4 4v34c0 18 14 32 32 32h46c18 0 32-14 32-32 0-8-4-16-10-20 3-2 5-5 5-8z"/>
          </svg>
          <span class="text-xs font-bold text-gray-200 group-hover:text-[#ffbd39] transition">Docker</span>
        </div>

        <!-- AWS Cloud -->
        <div class="flex flex-col items-center justify-center p-4 rounded-lg bg-[#0c0d11] border border-[#1a1c24] hover:border-[#ffbd39] transition group">
          <svg class="w-10 h-10 mb-2 group-hover:scale-110 transition" viewBox="0 0 128 128" fill="#FF9900">
            <path d="M38 78c-10 0-18-8-18-18s8-18 18-18c2 0 4 .3 6 .8C48 33 57 26 68 26c14 0 26 11 27 25 2-.4 5-.6 7-.6 10 0 18 8 18 18s-8 18-18 18H38z"/>
            <path d="M32 94c20 12 44 12 64 0" stroke="#FF9900" stroke-width="4" fill="none" stroke-linecap="round"/>
          </svg>
          <span class="text-xs font-bold text-gray-200 group-hover:text-[#ffbd39] transition">AWS Certified</span>
        </div>

        <!-- Debezium CDC -->
        <div class="flex flex-col items-center justify-center p-4 rounded-lg bg-[#0c0d11] border border-[#1a1c24] hover:border-[#ffbd39] transition group">
          <svg class="w-10 h-10 mb-2 group-hover:scale-110 transition" viewBox="0 0 128 128" fill="#A855F7">
            <path d="M24 64h80M64 24v80M36 36l56 56M36 92l56-56" stroke="#A855F7" stroke-width="8" stroke-linecap="round"/>
          </svg>
          <span class="text-xs font-bold text-gray-200 group-hover:text-[#ffbd39] transition">Debezium CDC</span>
        </div>
      </div>
    </div>
  </div>
</section>
