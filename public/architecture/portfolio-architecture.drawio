;dashed=0;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="solar-pv-train" target="solar-pv-shap"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="solar-pv-edge-label-12" value="Model + feature data" style="text;strokeColor=none;fillColor=#ffffff;fontSize=12;fontColor=#c46b08;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1023" y="1035" width="164" height="25" as="geometry"/></mxCell><mxCell id="solar-pv-edge-13" style="edgeStyle=none;rounded=0;html=1;strokeColor=#c46b08;strokeWidth=2;startArrow=none;startFill=0;endArrow=open;endFill=0;dashed=0;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0.84;entryY=1;entryPerimeter=0;" edge="1" parent="1" source="solar-pv-shap" target="solar-pv-app"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1490" y="1190"/></Array></mxGeometry></mxCell><mxCell id="solar-pv-edge-label-13" value="Explanations" style="text;strokeColor=none;fillColor=#ffffff;fontSize=12;fontColor=#c46b08;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1336.8" y="1175" width="106.4" height="25" as="geometry"/></mxCell><mxCell id="solar-pv-note-0" value="GMM = Gaussian Mixture Model. IF = Isolation Forest. Consensus and physical guards produce anomaly flags." style="text;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#526477;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="80" y="1305" width="1430" height="45" as="geometry"/></mxCell><mxCell id="solar-pv-note-1" value="Optuna trial output does not overwrite locked parameters. Screenshots are report snapshots, not live telemetry." style="text;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#526477;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="80" y="1328" width="1430" height="45" as="geometry"/></mxCell><mxCell id="solar-pv-legend" value="→ Data / request     - - → Control / metadata     ── Network link     ↔ Two-way exchange" style="text;strokeColor=none;fillColor=none;align=left;fontSize=13;fontColor=#526477;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="1362" width="1490" height="30" as="geometry"/></mxCell><mxCell id="solar-pv-footnote" value="Code-backed architecture. Optuna is a separate action; approved parameters are promoted manually." style="text;strokeColor=none;fillColor=none;align=left;fontSize=13;fontColor=#526477;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="1407" width="1490" height="35" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
